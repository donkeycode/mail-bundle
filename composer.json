{
    "name": "donkeycode/mail-bundle",
    "description": "An easy way to send mail with symfony/mailer and twig",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.1",
        "symfony/config": "^5.4|^6.4|^7.4",
        "symfony/dependency-injection": "^5.4|^6.4|^7.4",
        "symfony/http-kernel": "^5.4|^6.4|^7.4",
        "symfony/mailer": "^5.4|^6.4|^7.4",
        "symfony/mime": "^5.4|^6.4|^7.4",
        "twig/twig": "^3.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Cedric LOMBARDOT",
            "email": "cedric.lombardot@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "DonkeyCode\\MailBundle\\": ""
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}

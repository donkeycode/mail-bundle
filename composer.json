{
    "name": "donkeycode/mail-bundle",
    "description": "An easy way to send mail with swiftmailer and twig",
    "type": "symfony-bundle",
    "require": {
        "php": ">=7.4",
        "symfony/config": "^4.4|^5.4|^6.4",
        "symfony/dependency-injection": "^4.4|^5.4|^6.4",
        "symfony/http-kernel": "^4.4|^5.4|^6.4",
        "twig/twig": "*",
        "swiftmailer/swiftmailer": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Cedric LOMBARDOT",
            "email": "cedric.lombardot@gmail.com"
        }
    ],
